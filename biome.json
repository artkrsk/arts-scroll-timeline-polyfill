{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "src/js/**/*.js",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "tests/**/*.js",
      "tests/**/*.ts",
      "*.config.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "single" } },
  "linter": { "rules": { "preset": "recommended" } }
}
